{erl_opts, [debug_info, warnings_as_errors, {parse_transform, lager_transform}]}.

{deps, [
    {cowboy, "2.12.0"},
    {recon, "2.5.6"},
    {jiffy, "1.1.0"},
    {lager, "3.9.0"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [p72_torneo_de_esports, lager, recon]}
]}.

{relx, [
    {release, {p72_torneo_de_esports, "0.1.0"}, [p72_torneo_de_esports, sasl, recon]},
    {mode, prod},
    {extended_start_script, true},
    {vm_args, "config/vm.args"},
    {sys_config, "config/sys.config"},
    {include_erts, true},
    {include_src, false}
]}.

{profiles, [
    {dev, [{relx, [{dev_mode, true}, {include_erts, false}]}]},
    {test, [{erl_opts, [debug_info, warnings_as_errors, {parse_transform, lager_transform}]}]}
]}.

{xref_checks, [undefined_function_calls, locals_not_used, deprecated_function_calls]}.