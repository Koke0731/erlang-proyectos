[
 {p72_torneo_de_esports, [{http_port, 8080}]},
 {kernel, [
  {logger_level, info}
 ]},
 {lager, [
  {handlers, [
   {lager_console_backend, [
    {level, info},
    {formatter, lager_default_formatter},
    {formatter_config, [date, " ", time, " [", severity, "] ", module, ":", line, " ", message, "\n"]}
   ]}
  ]}
 ]}
].
